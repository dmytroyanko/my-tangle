# Required. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Required. Local dev (pnpm dev + `docker compose up -d`): Postgres from docker-compose on port 5433.
# Inside Docker (`docker compose --profile app up`) the app service overrides this to postgres:5432.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/my_tangle

# Public site address for canonical and hreflang links (default: https://my-tangle.com.ua).
SITE_URL=http://localhost:3000

# Optional. Media storage in Cloudflare R2 (or any S3-compatible bucket).
# When S3_BUCKET is empty, uploads are stored on disk in MEDIA_DIR (default: ./media).
S3_BUCKET=
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MEDIA_DIR=/app/media

# Nova Poshta API key (business account → Settings → Security). Optional: the checkout's city and branch
# search works without it.
NOVA_POSHTA_API_KEY=
